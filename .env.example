# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# FIREBASE_API_KEY: Your Firebase Project API key. You can find this in Google/Firebase services json or console.
FIREBASE_API_KEY=DUMMY_FIREBASE_API_KEY

# FIREBASE_APP_ID: Your Firebase App ID (format 1:502690676185:android:...)
FIREBASE_APP_ID=1:502690676185:android:d426a84dfc28e
